        <mxCell id="ypKqzQfI5kiMkzrTepFO-14" value="&lt;span id=&quot;docs-internal-guid-8890c362-7fff-0167-5758-e0444c56f01e&quot;&gt;&lt;h2 style=&quot;line-height:1.2;margin-top:2pt;margin-bottom:2pt;&quot; dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-size: 11pt; font-family: Arial, sans-serif; color: rgb(255, 0, 0); background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;&quot;&gt;docs: https://docs.google.com/document/d/1QMlOCKpoqg-Ff0JBWyVWw3rascpVhKBDGM1gFXzo-yo/edit?tab=t.0#heading=h.oilid0dady21&lt;/span&gt;&lt;/h2&gt;&lt;h2 style=&quot;line-height:1.2;margin-top:2pt;margin-bottom:2pt;&quot; dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-size: 11pt; font-family: Arial, sans-serif; color: rgb(255, 0, 0); background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;&quot;&gt;&lt;br&gt;users (base table for all accounts)&lt;/span&gt;&lt;/h2&gt;&lt;div align=&quot;left&quot; style=&quot;margin-left:0pt;&quot; dir=&quot;ltr&quot;&gt;&lt;table style=&quot;border:none;border-collapse:collapse;&quot;&gt;&lt;colgroup&gt;&lt;col width=&quot;111&quot;&gt;&lt;col width=&quot;124&quot;&gt;&lt;col width=&quot;226&quot;&gt;&lt;col width=&quot;164&quot;&gt;&lt;/colgroup&gt;&lt;tbody&gt;&lt;tr style=&quot;height:25.75pt&quot;&gt;&lt;td style=&quot;vertical-align:top;padding:5pt 5pt 5pt 5pt;overflow:hidden;overflow-wrap:break-word;&quot;&gt;&lt;p style=&quot;line-height:1.2;text-align: center;margin-top:2pt;margin-bottom:2pt;&quot; dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-size: 11pt; font-family: Arial, sans-serif; color: rgb(255, 0, 0); background-color: transparent; font-weight: 700; font-variant-