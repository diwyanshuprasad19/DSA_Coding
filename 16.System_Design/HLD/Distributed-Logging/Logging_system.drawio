          </mxGeometry>
        </mxCell>
        <mxCell id="_32XoB54ppftaPrC9bvZ-44" value="&lt;font style=&quot;font-size: 36px;&quot;&gt;1.2&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="860" y="-1970" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="_32XoB54ppftaPrC9bvZ-45" value="&lt;font style=&quot;font-size: 36px;&quot;&gt;1.3&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
