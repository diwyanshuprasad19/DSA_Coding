Code:

#include <bits/stdc++.h>
using namespace std;

class CustomStack {
public:
    stack<int> s1, s2;  // Two stacks
    int maxi = 0;       // Maximum size of the stack

    // Constructor to initialize the stack with maxSize
    CustomStack(int maxSize) {
        maxi = maxSize;
    }

    // Push an element onto the stack
    void push(int x) {
        if (s1.size() < maxi) {
            s1.push(x);
        }
    }

    // Pop the top element from the stack and return it
    int pop() {
        if (!s1.empty()) {
            int x = s1.top();
            s1.pop();
            return x;
        }
        return -1;
    }

    // Increment the bottom K elements by val
    void increment(int k, int val) {
        // Move elements to s2 while maintaining order
        while (s1.size() > k) {
            s2.push(s1.top());
            s1.pop();
        }

        // Add val to remaining elements in s1
        while (!s1.empty()) {
            s2.push(s1.top() + val);
            s1.pop();
        }

        // Move everything back from s2 to s1
        while (!s2.empty()) {
            s1.push(s2.top());
            s2.pop();
        }
    }
};

// Driver Code
int main() {
    CustomStack* obj = new CustomStack(3);  // Stack of maxSize 3
    obj->push(1);
    obj->push(2);
    cout << obj->pop() << endl;  // Output: 2
    obj->push(2);
    obj->push(3);
    obj->push(4);
    obj->increment(5, 100);
    obj->increment(2, 100);
    cout << obj->pop() << endl;  // Output: 103
    cout << obj->pop() << endl;  // Output: 202
    cout << obj->pop() << endl;  // Output: 201
    cout << obj->pop() << endl;  // Output: -1 (Stack is empty)

    delete obj;
    return 0;
}



Time and space:

Time & Space Complexity Analysis
Operation	Time Complexity	Explanation
Push	O(1)	Standard stack push() operation
Pop	O(1)	Standard stack pop() operation
Increment	O(N)	Moving elements back and forth between two stacks
Overall Space Complexity	O(N)	Uses two stacks, worst-case O(N)
